# AlgoFinex Frontend — Environment Variables Example
# Copy to .env.local for local overrides. Do NOT commit secrets here.

# Backend API Root URL (No trailing slash)
# Leave blank for local relative path routing, or specify full domain in production/staging
VITE_API_BASE_URL=https://api.algofinex.io

# Toggle local mock adapter simulation vs live backend HTTP requests
# Default: true
VITE_USE_MOCK=true
